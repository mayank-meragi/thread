{
  "name": "thread",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:app": "vitest run src",
    "test:worker": "vitest run --config workers/rss-proxy/vitest.config.ts",
    "rss-worker:login": "wrangler login",
    "rss-worker:dev": "wrangler dev --config workers/rss-proxy/wrangler.jsonc",
    "rss-worker:secret": "wrangler secret put RSS_PROXY_KEY --config workers/rss-proxy/wrangler.jsonc",
    "rss-worker:origins": "wrangler secret put ALLOWED_ORIGINS --config workers/rss-proxy/wrangler.jsonc",
    "rss-worker:deploy": "wrangler deploy --config workers/rss-proxy/wrangler.jsonc",
    "rss-worker:dry-run": "wrangler deploy --config workers/rss-proxy/wrangler.jsonc --dry-run",
    "rss-worker:typecheck": "tsc --noEmit -p workers/rss-proxy/tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.41",
    "@ai-sdk/google": "^4.0.50",
    "@ai-sdk/openai": "^4.0.46",
    "@assistant-ui/react": "^0.15.16",
    "@assistant-ui/react-markdown": "^0.14.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@floating-ui/dom": "^1.8.0",
    "@milkdown/core": "^7.22.1",
    "@milkdown/crepe": "latest",
    "@milkdown/plugin-slash": "^7.22.1",
    "@milkdown/plugin-trailing": "^7.22.1",
    "@milkdown/preset-commonmark": "^7.22.1",
    "@milkdown/prose": "^7.22.1",
    "@milkdown/utils": "^7.22.1",
    "@react-spring/web": "^10.1.2",
    "@use-gesture/react": "^10.3.1",
    "ai": "^7.0.77",
    "chrono-node": "^2.10.1",
    "dexie": "latest",
    "dexie-react-hooks": "latest",
    "dockview": "^8.2.0",
    "dockview-react": "^8.2.0",
    "dompurify": "^3.4.15",
    "fast-xml-parser": "^5.11.1",
    "lucide-react": "latest",
    "node-diff3": "^3.2.1",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260907.1",
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "fake-indexeddb": "^6.2.5",
    "globals": "latest",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "^4.129.0"
  }
}
